# ===== メール送信（Gmail の例） =====
# Gmail で「2 段階認証」を有効にし、https://myaccount.google.com/apppasswords で
# アプリパスワード（16 文字）を発行して SMTP_PASSWORD に入れてください。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.name@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# 送信元（空なら SMTP_USER）
MAIL_FROM=
# 通知先の初期値（画面の「通知設定」で変更できます）
MAIL_TO=your.name@gmail.com

# ===== 通知タイミング =====
# 定時ダイジェストの時刻の初期値（画面で変更できます）
DIGEST_TIMES=07:00,18:00
# フィードを取りに行く間隔（分）
FETCH_INTERVAL_MINUTES=30
TIMEZONE=Asia/Tokyo

# ===== アプリ =====
# メール内のリンク先。サーバーで公開する場合はその URL に変える
APP_BASE_URL=http://localhost:8000
# インターネットに公開する場合は必ず設定（Basic 認証）
APP_USERNAME=
APP_PASSWORD=
# 既読かつ「あとで読む」でない記事を何日で削除するか
RETENTION_DAYS=30
# 初回起動時におすすめフィードを登録するか
SEED_PRESETS=true
# DB（既定は data/feedly.db の SQLite）
# DATABASE_URL=sqlite:////absolute/path/feedly.db
